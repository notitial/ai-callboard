{
  "name": "callboard-panels",
  "displayName": "Callboard Panels",
  "description": "Opens, reopens and closes Claude Code panels for callboard, so a lead session can run its lanes in this window, and lists them in a Callboard Lanes view.",
  "version": "1.7.0",
  "publisher": "notitial",
  "icon": "icon.png",
  "galleryBanner": { "color": "#101d22", "theme": "dark" },
  "categories": ["Other"],
  "keywords": ["claude", "claude code", "callboard", "lanes", "agents"],
  "repository": { "type": "git", "url": "https://github.com/notitial/ai-manager" },
  "bugs": { "url": "https://github.com/notitial/ai-manager/issues" },
  "homepage": "https://github.com/notitial/ai-manager#readme",
  "engines": { "vscode": "^1.90.0" },
  "main": "./extension.js",
  "contributes": {
    "views": {
      "claude-sessions-sidebar": [{ "id": "callboardLanesSidebar", "name": "Callboard Lanes", "when": "claude-vscode.sessionsListEnabled", "visibility": "collapsed" }],
      "explorer": [{ "id": "callboardLanes", "name": "Callboard Lanes", "when": "!claude-vscode.sessionsListEnabled", "visibility": "collapsed" }]
    }
  },
  "activationEvents": ["onStartupFinished"],
  "extensionDependencies": ["anthropic.claude-code"],
  "type": "commonjs"
}
